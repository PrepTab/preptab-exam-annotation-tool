# Database (required for saving exams)
DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Cloudflare R2 for image uploads (same names as backend; optional)
# Set these to enable question/option image uploads directly to R2.
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_URL=
CLOUDFLARE_PUBLIC_URL=
